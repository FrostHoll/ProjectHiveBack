spring:
  datasource:
    url: jdbc:postgresql://your_db
    username: user_name
    password: user_password
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: create-drop
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    database: postgresql
    database-platform: org.hibernate.dialect.PostgreSQLDialect
app-version: 1.042
jwt:
  secret: jwt_secret